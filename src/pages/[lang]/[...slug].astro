---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render, getCollection } from "astro:content";

import { getLangFromUrl, useTranslatedPath, useTranslations } from "../../i18n/utils";

import Base from "../../layouts/Base.astro";
import Tag from "../../components/Tag.astro";

import { dateOptions } from "../../utils/types";

export const getStaticPaths = (async () => {
  const recipes = await getCollection("recipe");

  return recipes.map((recipe) => {
    const [lang, ...slug] = recipe.id.split("/");
    return {
      params: { lang, slug: slug.join("/") || undefined },
      props: recipe,
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const page = Astro.props as Props;

const { Content } = await render(page);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { data } = page;

const date = new Date(data.date);
---

<Base
  title={data.title}
  description={data.description}
  openGraph={{
    basic: {
      description: data.description,
      title: data.title,
      url: Astro.site!.href + Astro.url.pathname.slice(1),
      imageUrl: data.thumbnail.src,
    },
  }}
  twitter={{
    title: data.title,
    description: data.description,
    image: data.thumbnail.src,
  }}
>
  <article class="container mx-auto mb-24 px-2 pt-16 pb-12 md:px-10 md:pt-36">
    <header class="my-12">
      <a
        href={translatePath("/", lang)}
        class="mb-12 flex gap-2 text-zinc-700 transition-all duration-300 hover:gap-4"
      >
        <span>←</span>
        <span>{t("messages.return-previous-page")}</span>
      </a>

      <ul class="flex list-none flex-wrap gap-2 md:gap-3">
        {
          data.tags.map((tag: string) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))
        }
      </ul>

      <h1 class="text-4xl leading-[53px] tracking-tighter md:my-6 md:text-6xl md:leading-[73px]">
        {data.title}
      </h1>

      <time class="block text-base leading-6 text-balance text-zinc-700">
        {t("messages.updated")}{" "}
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString(lang, dateOptions)}
        </time>
      </time>

      <p class="block text-xl font-medium md:text-3xl">
        {data.description}
      </p>
    </header>

    <div
      class="prose-img:breakout prose-base prose-zinc lg:prose-xl prose-img:mb-24 prose-img:rounded-md prose-img:shadow-lg max-w-none"
    >
      <Content />
    </div>
  </article>
</Base>
